# ── Agent under test ──────────────────────────────────────────────────────────
GATEWAY_TOKEN=your-agent-gateway-token
API_BASE_URL=https://agent-api.example.com/v1
AGENT_MODEL=agentos/nova

# ── LLM judge: primary + fallback ─────────────────────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key
CLAUDE_API_KEY=your-anthropic-api-key
JUDGE_MODEL=claude-haiku-4-5-20251001
DEEPSEEK_DELAY_SECONDS=0.5
HAIKU_DELAY_SECONDS=0.2

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RESULTS_DIR=./results
LOGS_DIR=./logs
TEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
